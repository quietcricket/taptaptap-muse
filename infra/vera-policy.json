{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AppStorage",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-1:399049857363:table/taptaptap"
    },
    {
      "Sid": "RegistryLogin",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken"],
      "Resource": "*"
    },
    {
      "Sid": "PullAppImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": "arn:aws:ecr:ap-southeast-1:399049857363:repository/taptaptap"
    },
    {
      "Sid": "SendSignInLinks",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": [
        "arn:aws:ses:us-east-1:399049857363:identity/contact@birme.net",
        "arn:aws:ses:ap-southeast-1:399049857363:identity/contact@birme.net"
      ]
    }
  ]
}
